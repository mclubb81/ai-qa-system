# Which LLM provider to use: "groq" (default, free tier), "google", "anthropic",
# "openai", or "huggingface"
LLM_PROVIDER=groq

# Groq (default) -- free API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier via https://aistudio.google.com/apikey) -- used if LLM_PROVIDER=google
# Install with `pip install -e ".[google]"`
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Anthropic -- used if LLM_PROVIDER=anthropic. Install with `pip install -e ".[anthropic]"`
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI -- used if LLM_PROVIDER=openai. Install with `pip install -e ".[openai]"`
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Hugging Face Inference Providers (free credits via https://huggingface.co/settings/tokens)
# -- used if LLM_PROVIDER=huggingface, and by default for triage/codegen/healer
# (see node_candidate_providers in docs/logging-and-config.md) since it's the
# preferred provider for code-generation-heavy work. Falls back to groq
# automatically if unset. Install with `pip install -e ".[huggingface]"`
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Run a headless browser (set to false to watch the browser while debugging)
PLAYWRIGHT_HEADLESS=true

# Where reports get written
REPORTS_DIR=reports

# How many times to retry a test case the Analyzer judges "flaky"
MAX_RETRIES=1

# Generator: write a standalone Playwright regression script for every
# passing test case (adds an LLM call per passing test case -- off by
# default). Healed/re-validated later via `qa-agent heal`.
GENERATE_REGRESSION_SCRIPTS=false
GENERATED_TESTS_DIRNAME=generated_tests

# RAG (optional) -- grounds the Planner in indexed docs and lets Triage look up
# similar known bugs. Leave blank to run qa-agent exactly as before (no RAG).
# Qdrant Cloud free tier: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_DOCS_COLLECTION=qa_docs
QDRANT_BUGS_COLLECTION=qa_bugs

# Embeddings use Google text-embedding-004 (free tier) -- reuses GOOGLE_API_KEY
# above. Install with `pip install -e ".[rag]"`
RAG_EMBEDDING_MODEL=models/text-embedding-004
RAG_DOCS_TOP_K=5
RAG_BUGS_TOP_K=3

# Postgres (bootstrap-only -- these can't live in the config DB, since you
# need them to find it). Use a free managed Postgres provider (e.g. Neon,
# https://neon.tech) -- create a project, then run `CREATE DATABASE qa_config;`
# once to get the second database, and paste both connection strings below.
# See docs/logging-and-config.md#local-setup for the full steps.
# Install with `pip install -e ".[db]"`.
# Every setting above this point stays fully functional on its own -- these
# remain the fallback whenever the config DB is unset or unreachable. Values
# set via `qa-agent config set <key> <value>` take precedence once the config
# DB is reachable.
QA_LOGS_DATABASE_URL=postgresql://<user>:<password>@<host>/qa_logs?sslmode=require
QA_CONFIG_DATABASE_URL=postgresql://<user>:<password>@<host>/qa_config?sslmode=require
