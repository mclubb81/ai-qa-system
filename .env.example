# Which LLM provider to use: "groq" (default, free tier), "google", "anthropic", or "openai"
LLM_PROVIDER=groq

# Groq (default) -- free API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier via https://aistudio.google.com/apikey) -- used if LLM_PROVIDER=google
# Install with `pip install -e ".[google]"`
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Anthropic -- used if LLM_PROVIDER=anthropic. Install with `pip install -e ".[anthropic]"`
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI -- used if LLM_PROVIDER=openai. Install with `pip install -e ".[openai]"`
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Run a headless browser (set to false to watch the browser while debugging)
PLAYWRIGHT_HEADLESS=true

# Where reports get written
REPORTS_DIR=reports

# How many times to retry a test case the Analyzer judges "flaky"
MAX_RETRIES=1

# RAG (optional) -- grounds the Planner in indexed docs and lets Triage look up
# similar known bugs. Leave blank to run qa-agent exactly as before (no RAG).
# Qdrant Cloud free tier: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_DOCS_COLLECTION=qa_docs
QDRANT_BUGS_COLLECTION=qa_bugs

# Embeddings use Google text-embedding-004 (free tier) -- reuses GOOGLE_API_KEY
# above. Install with `pip install -e ".[rag]"`
RAG_EMBEDDING_MODEL=models/text-embedding-004
RAG_DOCS_TOP_K=5
RAG_BUGS_TOP_K=3

# Postgres (bootstrap-only -- these can't live in the config DB, since you
# need them to find it). Run `docker compose up -d` for a local Postgres with
# both qa_logs and qa_config databases created automatically.
# Install with `pip install -e ".[db]"`.
# Every setting above this point stays fully functional on its own -- these
# remain the fallback whenever the config DB is unset or unreachable. Values
# set via `qa-agent config set <key> <value>` take precedence once the config
# DB is reachable.
QA_LOGS_DATABASE_URL=postgresql://qa_agent:qa_agent_dev_password@localhost:5432/qa_logs
QA_CONFIG_DATABASE_URL=postgresql://qa_agent:qa_agent_dev_password@localhost:5432/qa_config

# Credentials for the docker-compose Postgres container
POSTGRES_USER=qa_agent
POSTGRES_PASSWORD=qa_agent_dev_password
